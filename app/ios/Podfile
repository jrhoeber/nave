require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Required for @react-native-firebase with React Native New Architecture
$RNFirebaseAsStaticFramework = true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'Nave' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  # Modular headers required by Swift-pod Firebase dependencies
  # (FirebaseCoreInternal, FirebaseCrashlytics, FirebaseSessions).
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Copy Hermes dSYMs into the archive so App Store Connect validation passes
    app_project = Xcodeproj::Project.open("#{installer.sandbox.root}/../Nave.xcodeproj")
    app_project.targets.each do |target|
      next unless target.name == 'Nave'
      next if target.shell_script_build_phases.any? { |p| p.name == 'Copy Hermes dSYMs' }
      phase = target.new_shell_script_build_phase('Copy Hermes dSYMs')
      phase.shell_script = <<~SCRIPT
        HERMES_DSYM="${PODS_ROOT}/hermes-engine/destroot/Library/Frameworks/universal/hermes.xcframework/ios-arm64/hermes.framework.dSYM"
        if [ -d "${HERMES_DSYM}" ]; then
          cp -r "${HERMES_DSYM}" "${DWARF_DSYM_FOLDER_PATH}"
        fi
      SCRIPT
    end
    app_project.save
    # Patch fmt/base.h to disable consteval on Apple Clang (broken in Xcode 26+)
    fmt_base = "#{installer.sandbox.root}/fmt/include/fmt/base.h"
    if File.exist?(fmt_base)
      File.chmod(0644, fmt_base)
      content = File.read(fmt_base)
      patched = content.gsub(
        '#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L',
        '#elif defined(__apple_build_version__)'
      )
      File.write(fmt_base, patched) if patched != content
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
      end
    end

    # Force the react-native-config Pod target to read .env.production in Release builds.
    # The ENVFILE setting on the Nave app target does not propagate to Pod targets, so
    # archives from the Xcode GUI (which don't have an ENVFILE shell env var) silently
    # fall back to .env (localhost). Only override Release — Debug is left unset so the
    # Makefile's shell-exported ENVFILE (e.g. ENVFILE=.env.hosted) still wins for `make ios`.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-config'
      target.build_configurations.each do |config|
        next unless config.name == 'Release'
        # Resolved relative to HOST_PATH ("<app>/") inside BuildDotenvConfig.rb.
        config.build_settings['ENVFILE'] = '.env.production'
      end
    end
  end
end
